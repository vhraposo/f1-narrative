  WIKIDATA
  F1_OFFICIAL
  FIA_OFFICIAL
  TEAM_OFFICIAL
  DRIVER_OFFICIAL
  REPUTABLE_NEWS
  CURATED
}

enum ExternalKnowledgeSourceKind {
  STRUCTURED_RELEASE
  OFFICIAL_PROFILE
  INTERVIEW
  PRESS_CONFERENCE
  BIOGRAPHY_PAGE
  NEWS_REPORT
  DATABASE_EXPORT
  PUBLIC_STATEMENT
}

enum ExternalKnowledgeLicense {
  CC_BY_4_0
  CC0
  CC_BY_SA_4_0
  PROPRIETARY_REFERENCE_ONLY
  UNKNOWN
}

enum ExternalRefreshStatus {
  FRESH
  STALE
  UNKNOWN
