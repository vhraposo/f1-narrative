  universeId     String            @db.Uuid
  universe       Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalRaceId String            @db.Uuid
  externalRace   ExternalRace      @relation(fields: [externalRaceId], references: [id], onDelete: Cascade)
  raceId         String            @unique @db.Uuid
  race           Race              @relation(fields: [raceId], references: [id], onDelete: Cascade)
  confidence     BindingConfidence @default(SUGGESTED)
  boundAt        DateTime          @default(now())
  boundBy        Role?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([universeId, externalRaceId])
}

model ExternalBindingDriverSeason {
  id                     String               @id @default(uuid()) @db.Uuid
  universeId             String               @db.Uuid
  universe               Universe             @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalDriverSeasonId String               @db.Uuid
  externalDriverSeason   ExternalDriverSeason @relation(fields: [externalDriverSeasonId], references: [id], onDelete: Cascade)
  seasonDriverEntryId    String               @unique @db.Uuid
  seasonDriverEntry      SeasonDriverEntry    @relation(fields: [seasonDriverEntryId], references: [id], onDelete: Cascade)
  confidence             BindingConfidence    @default(SUGGESTED)
  boundAt                DateTime             @default(now())
  boundBy                Role?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([universeId, externalDriverSeasonId])
}

model ExternalBindingResult {
  id               String            @id @default(uuid()) @db.Uuid
  universeId       String            @db.Uuid
  universe         Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalResultId String            @db.Uuid
  externalResult   ExternalResult    @relation(fields: [externalResultId], references: [id], onDelete: Cascade)
  raceResultId     String            @unique @db.Uuid
  raceResult       RaceResult        @relation(fields: [raceResultId], references: [id], onDelete: Cascade)
  confidence       BindingConfidence @default(SUGGESTED)
  boundAt          DateTime          @default(now())
  boundBy          Role?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

