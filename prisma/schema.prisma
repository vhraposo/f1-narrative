model ExternalBindingStanding {
  id                     String               @id @default(uuid()) @db.Uuid
  universeId             String               @db.Uuid
  universe               Universe             @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalStandingId     String               @db.Uuid
  externalStanding       ExternalStanding     @relation(fields: [externalStandingId], references: [id], onDelete: Cascade)
  championshipStandingId String               @unique @db.Uuid
  championshipStanding   ChampionshipStanding @relation(fields: [championshipStandingId], references: [id], onDelete: Cascade)
  confidence             BindingConfidence    @default(SUGGESTED)
  boundAt                DateTime             @default(now())
  boundBy                Role?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

