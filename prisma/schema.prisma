// F1 Narrative Universe — Prisma Schema
// Revisão conceitual do modelo de domínio.
//
// Princípios desta revisão:
// - Character é o ator central do universo (controlado por USER ou AI).
// - DriverProfile é o perfil esportivo opcional de um Character (1:0..1).
// - WorldState mantém apenas referências escalares ao estado ativo, sem
//   circularidade com Season/Race/Conversation.
// - Relationship é única por par de personagens (simétrica, sem A→B e B→A).
// - Memory pode envolver múltiplos personagens (N:N) e um evento (N:1).
// - Event pode envolver múltiplos personagens participantes (N:N).
// - Sem pgvector/embeddings inicial — adicionado na Fase 13 STEP 7 (ExternalChunk
//   ganhou coluna vector(1024) + embeddedContentHash; provider Cohere, cosine).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papel do usuário na aplicação.
enum Role {
  USER
  ADMIN
}

/// Quem controla o comportamento de um Character dentro do universo.
enum CharacterController {
  USER
  AI
}

enum SeasonStatus {
  PRE_SEASON
  ACTIVE
  FINISHED
}

enum RaceStatus {
  UPCOMING
  QUALIFYING
  RACE
  FINISHED
}

/// Sessão ativa do fim de semana de corrida.
enum RaceSession {
  PRACTICE
  QUALIFYING
  RACE
}

enum ConversationType {
  GROUP
  DM
}

/// Origem (quem efetivamente enviou) de uma Message.
enum MessageSenderType {
  USER_CHARACTER
  AI_CHARACTER
  SYSTEM
}

enum MemoryImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CanonSource {
  CANON
  USER_DEFINED
  GENERATED_EVENT
  EXTERNAL_INFORMATION
}

/// Categoria de uma origem externa (fonte pesquisada/ingestada).
enum ExternalSourceType {
  ARTICLE
  WEBSITE
  DOCUMENT
  DATABASE
  API
  SEARCH_RESULT
}

/// Escopo de acesso a uma fonte externa.
enum ExternalSourceVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

/// Estado de processamento de um documento externo.
enum ExternalDocumentStatus {
  NEW
  READY
  STALE
  FAILED
}

enum EventType {
  RACE
  RACE_INCIDENT
  RELATIONSHIP
  SOCIAL
  PERSONAL
  NEWS
  WORLD
}

enum EventImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  TRAINING
  TRAVELING
  SLEEPING
  RACE_WEEKEND
  OFFLINE
}

enum DriverRole {
  RACE_SEAT
  RESERVE
}

enum DriverStatus {
  ACTIVE
  AVAILABLE
  LEFT
  INACTIVE
}

enum Provenance {
  CANONICAL
  IMPORTED
  HYBRID
  SIMULATED
}

enum BindingConfidence {
  SUGGESTED
  CONFIRMED
}

enum DriverEntryEventKind {
  CREATED
  SEATED
  DISPLACED
  HIRED
  RELEASED
  PROMOTED
  STATUS_CHANGED
}

/// Conta de acesso da aplicação.
enum UniverseStatus {
  PENDING
  READY
  FAILED
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique
  name          String
  password      String?
  role          Role    @default(USER)
  emailVerified Boolean @default(false)
  image         String?

  universe        Universe?
  characters      Character[]
  sessions        Session[]
  accounts        Account[]
  teams           Team[]
  externalSources ExternalSource[]

  universeEditorDecisions UniverseEditorDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Raiz do universo de um usuário: Season, Team, Character de piloto,
/// WorldState e bindings de materialização pertencem a exatamente um Universe.
/// O External Mirror permanece global/factual.
model Universe {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    UniverseStatus @default(PENDING)
  lastError String?

  seasons     Season[]
  teams       Team[]
  characters  Character[]
  circuits    Circuit[]
  worldStates WorldState[]
  timelineEvents TimelineEvent[]
  worldSnapshots WorldSnapshot[]

  bindingDrivers       ExternalBindingDriver[]
  bindingTeams         ExternalBindingTeam[]
  bindingSeasons       ExternalBindingSeason[]
  bindingRaces         ExternalBindingRace[]
  bindingCircuits      ExternalBindingCircuit[]
  bindingDriverSeasons ExternalBindingDriverSeason[]
  bindingResults       ExternalBindingResult[]
  bindingStandings     ExternalBindingStanding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sessão de autenticação gerenciada pelo Better-Auth.
model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Conta de autenticação gerenciada pelo Better-Auth (email/password e,
/// no futuro, provedores OAuth).
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  issuer                String?
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Verificação de e-mail / códigos de validação (Better-Auth).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

/// Atores do universo. Podem ser controlados pelo usuário ou pela IA.
model Character {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @db.Uuid
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  universeId   String?             @db.Uuid
  universe     Universe?           @relation(fields: [universeId], references: [id], onDelete: Cascade)
  controlledBy CharacterController @default(USER)

  name        String
  nationality String
  gender      String?
  birthDate   DateTime
  imageUrl    String?

  // Character DNA — fonte de verdade para características narrativas
  // (personalidade, temperamento, maneira de falar, gostos, hábitos, etc.)
  dna       Json    @default("{}")
  biography String?

  // Perfil esportivo opcional (caso seja piloto)
  driverProfile DriverProfile?

  externalDriverBindings ExternalBindingDriver[]

  relationshipsA           Relationship[]            @relation("characterA")
  relationshipsB           Relationship[]            @relation("characterB")
  availability             CharacterAvailability?
  schedules                CharacterSchedule[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  memoryMemberships        MemoryCharacter[]
  eventMemberships         EventCharacter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([universeId])
}

/// Perfil esportivo de um Character que é piloto (0..1 por personagem).
model DriverProfile {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @unique @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  teamId String? @db.Uuid
  team   Team?   @relation(fields: [teamId], references: [id])
  number Int?

  customHeadshotUrl String?

  results               RaceResult[]
  championshipStandings ChampionshipStanding[]
  seasonDriverEntries   SeasonDriverEntry[]
  driverAttributes      DriverAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

/// Equipe esportiva (vínculo feito via perfil de piloto).
/// As equipes são por usuário: `name` é único dentro do mesmo usuário,
/// não globalmente.
model Team {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  shortName      String?
  color          String?
  // Identidade visual (paleta) que acompanha a entidade Team. Sem suporte
  // temporal completo: representa a identidade atual da equipe.
  visualIdentity Json?
  driverProfiles DriverProfile[]

  seasonDriverEntries  SeasonDriverEntry[]
  externalTeamBindings ExternalBindingTeam[]

  universeEditorDecisions UniverseEditorDecision[]

  teamPerformances TeamPerformance[]

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, name])
  @@index([userId])
  @@index([universeId])
}

/// Temporada do campeonato.
model Season {
  id     String       @id @default(uuid()) @db.Uuid
  year   Int
  name   String?
  status SeasonStatus @default(PRE_SEASON)

  provenance Provenance @default(CANONICAL)

  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  races                 Race[]
  championshipStandings ChampionshipStanding[]

  seasonDriverEntries    SeasonDriverEntry[]
  externalSeasonBindings ExternalBindingSeason[]

  universeEditorDecisions UniverseEditorDecision[]
  teamPerformances         TeamPerformance[]
  driverAttributes         DriverAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, year])
  @@index([universeId])
}

/// Corrida do calendário de uma temporada.
model Race {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  name    String
  circuit String?
  country String?
  date    DateTime?
  round   Int?
  status  RaceStatus @default(UPCOMING)

  circuitId String?  @db.Uuid
  circuitRef Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  provenance Provenance @default(CANONICAL)

  results              RaceResult[]
  externalRaceBindings ExternalBindingRace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([status])
  @@index([circuitId])
}

/// Resultado esportivo determinístico de um piloto em uma corrida.
/// Incidentes narrativos pertencem ao sistema de Events, não a este modelo.
model RaceResult {
  id              String        @id @default(uuid()) @db.Uuid
  raceId          String        @db.Uuid
  race            Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  driverProfileId String        @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])

  position   Int?
  points     Float      @default(0)
  grid       Int?
  fastestLap Boolean    @default(false)
  status     String?
  provenance Provenance @default(CANONICAL)
  sourceHash String?

  externalBindings ExternalBindingResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raceId, driverProfileId])
  @@index([raceId])
  @@index([driverProfileId])
}

/// Pontos acumulados de um piloto em uma temporada.
model ChampionshipStanding {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  season          Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  driverProfileId String        @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])

  points     Float      @default(0)
  position   Int?
  wins       Int        @default(0)
  podiums    Int        @default(0)
  provenance Provenance @default(CANONICAL)
  sourceHash String?

  externalBindings ExternalBindingStanding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, driverProfileId])
  @@index([seasonId])
  @@index([driverProfileId])
}

model SeasonDriverEntry {
  id              String        @id @default(uuid()) @db.Uuid
  driverProfileId String        @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  seasonId        String        @db.Uuid
  season          Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  teamId          String?       @db.Uuid
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)

  role       DriverRole?
  seat       Int?
  number     Int?
  status     DriverStatus @default(ACTIVE)
  provenance Provenance   @default(CANONICAL)

  events           DriverEntryEvent[]
  externalBindings ExternalBindingDriverSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, driverProfileId])
  @@unique([seasonId, teamId, seat])
  @@index([seasonId])
  @@index([driverProfileId])
  @@index([teamId, status])
}

model TeamPerformance {
  id       String   @id @default(uuid()) @db.Uuid
  seasonId String   @db.Uuid
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId   String   @db.Uuid
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  carSpeed    Float @default(50)
  reliability Float @default(50)
  operations  Float @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([teamId])
}

model DriverAttribute {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  season          Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  driverProfileId String        @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  speed       Float @default(50)
  consistency Float @default(50)
  racecraft   Float @default(50)
  aggression  Float @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, driverProfileId])
  @@index([seasonId])
  @@index([driverProfileId])
}

model DriverEntryEvent {
  id        String               @id @default(uuid()) @db.Uuid
  entryId   String               @db.Uuid
  entry     SeasonDriverEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind      DriverEntryEventKind
  from      Json?
  to        Json?
  reason    String?
  createdAt DateTime             @default(now())

  @@index([entryId, createdAt])
}

/// Registro durável e anexável da decisão "manter o universo" tomada no
/// Universe Editor para uma equipe em uma temporada. Não é fonte de verdade
/// do roster (SeasonDriverEntry permanece autoridade); preserva apenas o
/// reconhecimento do usuário sobre divergências naquele momento. A criação
/// é idempotente por signature (estado dos assentos reconhecido).
model UniverseEditorDecision {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId  String   @db.Uuid
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  signature String
  seats     Json
  createdAt DateTime @default(now())

  @@unique([userId, seasonId, teamId, signature])
  @@index([userId, seasonId, teamId])
}

model ExternalDriver {
  id            String   @id @default(uuid()) @db.Uuid
  source        String
  externalId    String
  name          String
  fullName      String?
nationality String?
  number        Int?
  // Enriquecimento visual externo: URL da foto do rosto fornecida por uma
  // fonte de mídia (ex.: OpenF1). Nunca tratada como truth de personagem.
  headshotUrl   String?
  contentHash   String
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())
  sourceRecord  Json?

  driverSeasons     ExternalDriverSeason[]
  externalResults   ExternalResult[]
  externalStandings ExternalStanding[]
  bindings          ExternalBindingDriver[]

  @@unique([source, externalId])
  @@index([source, name])
}

model ExternalTeam {
  id            String   @id @default(uuid()) @db.Uuid
  source        String
  externalId    String
  name          String
  shortName     String?
  color         String?
  contentHash   String
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())
  sourceRecord  Json?

  bindings ExternalBindingTeam[]

  @@unique([source, externalId])
}

model ExternalDriverSeason {
  id               String         @id @default(uuid()) @db.Uuid
  source           String
  externalDriverId String         @db.Uuid
  externalDriver   ExternalDriver @relation(fields: [externalDriverId], references: [id], onDelete: Restrict)
  seasonYear       Int
  teamExternalId   String?
  teamNameSnapshot String?
  number           Int?
  role             String?
  contentHash      String
  firstSyncedAt    DateTime       @default(now())
  lastSyncedAt     DateTime       @default(now())
  sourceRecord     Json?

  bindings ExternalBindingDriverSeason[]

  @@unique([source, externalDriverId, seasonYear])
  @@index([seasonYear])
}

model ExternalSeason {
  id            String   @id @default(uuid()) @db.Uuid
  source        String
  year          Int
  name          String?
  status        String?
  contentHash   String
  sourceRecord  Json?
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())

  bindings ExternalBindingSeason[]

  @@unique([source, year])
}

/// Circuito factual do espelho externo (Jolpica e futuras fontes). Não pertence
/// a nenhum Universe — o Circuit do universo é materializado a partir daqui.
model ExternalCircuit {
  id            String   @id @default(uuid()) @db.Uuid
  source        String
  externalId    String
  name          String
  url           String?
  locality      String?
  country       String?
  latitude      Float?
  longitude     Float?
  lengthMeters  Int?
  turns         Int?
  direction     String?
  layoutKey     String?
  contentHash   String
  sourceRecord  Json?
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())

  races    ExternalRace[]
  bindings ExternalBindingCircuit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([source, name])
}

/// Circuito do universo do usuário: entidade própria, independente do espelho.
model Circuit {
  id         String   @id @default(uuid()) @db.Uuid
  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  name         String
  shortName    String?
  locality     String?
  country      String?
  latitude     Float?
  longitude    Float?
  lengthMeters Int?
  turns        Int?
  direction    String?
  layoutKey    String?
  layoutUrl    String?
  photoUrl     String?

  provenance Provenance @default(CANONICAL)

  races    Race[]
  bindings ExternalBindingCircuit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, name])
  @@index([universeId])
}

model ExternalBindingCircuit {
  id                String            @id @default(uuid()) @db.Uuid
  universeId        String            @db.Uuid
  universe          Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalCircuitId String            @db.Uuid
  externalCircuit   ExternalCircuit   @relation(fields: [externalCircuitId], references: [id], onDelete: Cascade)
  circuitId         String            @unique @db.Uuid
  circuit           Circuit           @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  confidence        BindingConfidence @default(SUGGESTED)
  boundAt           DateTime          @default(now())
  boundBy           Role?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([universeId, externalCircuitId])
}

enum ExternalSyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Registro de execução de sincronização externa (auditoria, lock e lastSyncAt).
model ExternalSyncRun {
  id            String             @id @default(uuid()) @db.Uuid
  source        String
  scope         String
  seasonYear    Int?
  status        ExternalSyncStatus @default(RUNNING)
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  lastSyncedAt  DateTime?
  statistics    Json?
  error         String?
  triggeredById String?            @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, scope, seasonYear, startedAt])
}

model ExternalRace {
  id                String           @id @default(uuid()) @db.Uuid
  source            String
  seasonYear        Int
  round             Int
  grandPrix         String?
  name              String?
  officialName      String?
  circuitName       String?
  circuitExternalId String?
  locality          String?
  country           String?
  latitude          Float?
  longitude         Float?
  time              String?
  url               String?
  date              DateTime?
  status            String?
  contentHash       String
  sourceRecord      Json?
  firstSyncedAt     DateTime         @default(now())
  lastSyncedAt      DateTime         @default(now())

  externalCircuitId String?          @db.Uuid
  externalCircuit   ExternalCircuit? @relation(fields: [externalCircuitId], references: [id], onDelete: SetNull)

  results  ExternalResult[]
  bindings ExternalBindingRace[]

  @@unique([source, seasonYear, round])
  @@index([source, seasonYear])
  @@index([externalCircuitId])
}

model ExternalResult {
  id               String         @id @default(uuid()) @db.Uuid
  source           String
  externalRaceId   String         @db.Uuid
  externalRace     ExternalRace   @relation(fields: [externalRaceId], references: [id], onDelete: Restrict)
  externalDriverId String         @db.Uuid
  externalDriver   ExternalDriver @relation(fields: [externalDriverId], references: [id], onDelete: Restrict)

  position      Int?
  points        Float?
  grid          Int?
  fastestLap    Boolean?
  status        String?
  contentHash   String
  sourceRecord  Json?
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())

  bindings ExternalBindingResult[]

  @@unique([source, externalRaceId, externalDriverId])
  @@index([externalRaceId])
  @@index([externalDriverId])
}

model ExternalStanding {
  id               String         @id @default(uuid()) @db.Uuid
  source           String
  seasonYear       Int
  externalDriverId String         @db.Uuid
  externalDriver   ExternalDriver @relation(fields: [externalDriverId], references: [id], onDelete: Restrict)

  position      Int?
  points        Float?
  wins          Int?
  podiums       Int?
  contentHash   String
  sourceRecord  Json?
  firstSyncedAt DateTime @default(now())
  lastSyncedAt  DateTime @default(now())

  bindings ExternalBindingStanding[]

  @@unique([source, seasonYear, externalDriverId])
  @@index([externalDriverId])
}

model ExternalBindingDriver {
  id               String            @id @default(uuid()) @db.Uuid
  universeId       String            @db.Uuid
  universe         Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalDriverId String            @db.Uuid
  externalDriver   ExternalDriver    @relation(fields: [externalDriverId], references: [id], onDelete: Cascade)
  characterId      String            @unique @db.Uuid
  character        Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  confidence       BindingConfidence @default(SUGGESTED)
  boundAt          DateTime          @default(now())
  boundBy          Role?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([universeId, externalDriverId])
}

model ExternalBindingTeam {
  id             String            @id @default(uuid()) @db.Uuid
  universeId     String            @db.Uuid
  universe       Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalTeamId String            @db.Uuid
  externalTeam   ExternalTeam      @relation(fields: [externalTeamId], references: [id], onDelete: Cascade)
  teamId         String            @unique @db.Uuid
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  confidence     BindingConfidence @default(SUGGESTED)
  boundAt        DateTime          @default(now())
  boundBy        Role?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([universeId, externalTeamId])
}

model ExternalBindingSeason {
  id               String            @id @default(uuid()) @db.Uuid
  universeId       String            @db.Uuid
  universe         Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  externalSeasonId String            @db.Uuid
  externalSeason   ExternalSeason    @relation(fields: [externalSeasonId], references: [id], onDelete: Cascade)
  seasonId         String            @unique @db.Uuid
  season           Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  confidence       BindingConfidence @default(SUGGESTED)
  boundAt          DateTime          @default(now())
  boundBy          Role?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([universeId, externalSeasonId])
}

model ExternalBindingRace {
