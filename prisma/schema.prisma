// ---------------------------------------------------------------
// Chat
// ---------------------------------------------------------------

/// Visibilidade de uma Conversation. PRIVATE = somente participantes
/// listados (comportamento atual). UNIVERSE está reservado para grupos
/// abertos do mesmo Universe; enquanto não implementado o acesso permanece
/// fail-closed (somente participantes).
enum ConversationVisibility {
  PRIVATE
  UNIVERSE
}

/// Grupo ou conversa direta composta por Characters.
model Conversation {
  id         String                 @id @default(uuid()) @db.Uuid
  title      String?
  type       ConversationType       @default(GROUP)
  status     ConversationStatus     @default(ACTIVE)
  visibility ConversationVisibility @default(PRIVATE)

  participants ConversationParticipant[]
  messages     Message[]
  ragFrames    ConversationRagFrame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Participação de um Character em uma Conversation (N:N).
model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  characterId    String       @db.Uuid
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, characterId])
}

/// Mensagem de chat. O remetente é identificado por senderType + characterId.
/// - USER_CHARACTER / AI_CHARACTER: characterId obrigatório
/// - SYSTEM: characterId deve ser null
/// contextJson: snapshot/metadata do contexto narrativo usado na geração (API
/// 1:N). NÃO é fonte de verdade — a montagem completa continua no assembly em
/// request-time; aqui só referência/metadata suficiente para reconstrução.
model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  characterId    String?           @db.Uuid
  character      Character?        @relation(fields: [characterId], references: [id])
  content        String
  contextJson    Json?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------
// Memória
// ---------------------------------------------------------------

/// Memória persistente do universo. Pode envolver múltiplos personagens
/// (via MemoryCharacter) e pode ser originada por um Event.
model Memory {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String? @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id])

  universeId String?   @db.Uuid
  universe   Universe? @relation(fields: [universeId], references: [id], onDelete: Cascade)

  memoryType PilotExperienceType?
  derivation PilotMemoryDerivation @default(MANUAL)
  status     PilotMemoryStatus     @default(ACTIVE)
  revision   Int                   @default(1)

  experienceId String?          @db.Uuid
  experience   PilotExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  timelineEventId String?        @db.Uuid
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id], onDelete: SetNull)

  derivedKey          String?
  updatedByRevisionAt DateTime?

  importance      MemoryImportance  @default(LOW)
  source          CanonSource       @default(USER_DEFINED)
  content         String
  summary         String?
  context         Json?
  participants    MemoryCharacter[]
  emotionalImpact Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importance])
  @@index([eventId])
  @@index([universeId, status])
  @@index([universeId, derivedKey])
  @@index([experienceId])
  @@index([timelineEventId])
}

/// Associação N:N entre Memory e Character (personagens aos quais a memória é relevante).
model MemoryCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  memoryId    String    @db.Uuid
  memory      Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([memoryId, characterId])
}

// ---------------------------------------------------------------
// Relacionamentos
// ---------------------------------------------------------------

/// Relação simétrica única entre dois Characters (A↔B, nunca A→B e B→A).
/// As dimensões narrativas evoluem no JSON `dimensions`.
model Relationship {
  id           String    @id @default(uuid()) @db.Uuid
  characterAId String    @db.Uuid
  characterA   Character @relation("characterA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterBId String    @db.Uuid
  characterB   Character @relation("characterB", fields: [characterBId], references: [id], onDelete: Cascade)

  // Dimensões multidimensionais (amizade, confiança, respeito, rivalidade, ...)
  dimensions Json @default("{}")

  changes RelationshipChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterAId, characterBId])
  @@index([characterAId])
}

// ---------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------

/// Acontecimento do universo. Tipos bem definidos; o payload JSON carrega
/// dados específicos do tipo. Pode envolver múltiplos Characters e gerar
/// memórias e notícias.
model Event {
  id          String          @id @default(uuid()) @db.Uuid
  type        EventType
  importance  EventImportance @default(MEDIUM)
  source      CanonSource     @default(GENERATED_EVENT)
  title       String
  description String?
  worldDate   DateTime?
  payload     Json?

  createdById String? @db.Uuid
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  participants EventCharacter[]
  memories     Memory[]
  newsItems    NewsItem[]
  pilotExperiences PilotExperience[]

  createdAt DateTime @default(now())

  @@index([type])
  @@index([worldDate])
  @@index([createdById])
}

/// Associação N:N entre Event e Character (personagens participantes).
model EventCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([eventId, characterId])
}

// ---------------------------------------------------------------
// Notícias e fontes externas
// ---------------------------------------------------------------

/// Notícia do universo, derivada de um Event.
model NewsItem {
  id        String      @id @default(uuid()) @db.Uuid
  eventId   String?     @db.Uuid
  event     Event?      @relation(fields: [eventId], references: [id])
  title     String
  body      String?
  source    CanonSource @default(GENERATED_EVENT)
  worldDate DateTime?

  createdAt DateTime @default(now())

  @@index([worldDate])
}

/// Fonte pesquisada na web (feature futura — apenas modelo preparado).
/// Representa a ORIGEM auditável de informação externa. Não é um documento:
/// documentos (ExternalDocument) e chunks (ExternalChunk) derivam dela.
model ExternalSource {
  id          String                   @id @default(uuid()) @db.Uuid
  url         String
  title       String?
  snippet     String?
  reliability Int?
  sourceType  ExternalSourceType?
  visibility  ExternalSourceVisibility @default(PRIVATE)

  // Proprietário opcional. Concede escopo de acesso (PRIVADO por padrão);
  // PUBLIC/SHARED não exigem dono. Usuário deletado => SetNull (fonte pública
  // sobrevive).
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  documents ExternalDocument[]

  @@index([fetchedAt])
  @@index([ownerId])
  @@index([sourceType])
}

/// Documento externo obtido de uma ExternalSource. Conteúdo íntegro +
/// contentHash para provenance e detecção de alterações (freshness).
model ExternalDocument {
  id          String                 @id @default(uuid()) @db.Uuid
  sourceId    String                 @db.Uuid
  source      ExternalSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title       String
  content     String
  contentHash String
  status      ExternalDocumentStatus @default(NEW)
  publishedAt DateTime?
  fetchedAt   DateTime               @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks ExternalChunk[]

  // Mesma fonte + mesmo conteúdo => mesmo documento (evita duplicatas).
  @@unique([sourceId, contentHash])
  @@index([sourceId])
  @@index([status])
}

/// Chunk textual de um ExternalDocument. Ordem original preservada via
/// `orderOriginal`; contentHash para versionamento. O vetor de embedding é
/// representado por um tipo customizado pgvector `vector(1024)` (Cohere
/// `embed-multilingual-v3.0`, cosine) e é NULLABLE: um chunk pode existir sem
/// embedding (ausência de vector NÃO é erro de storage). `embeddedContentHash`
/// vincula o vetor ao contentHash exato que foi embeddado.
model ExternalChunk {
  id            String           @id @default(uuid()) @db.Uuid
  documentId    String           @db.Uuid
  document      ExternalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text          String
  orderOriginal Int
  contentHash   String

  // Metadata de provenance/versionamento do embedding (preenchida SOMENTE após
  // um embedding real ser gerado e validado).
  embeddingProvider   String?
  embeddingModel      String?
  embeddingVersion    String?
  embeddingDimensions Int?

  // Vetor pgvector (1024 dims) + contentHash embeddado. Unsupported porque o
  // Prisma não tem tipo nativo para vector; leitura/escrita via SQL raw.
  embedding           Unsupported("vector(1024)")?
  embeddedContentHash String?

  ragSnapshotItems ConversationRagSnapshotItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, orderOriginal])
  @@index([documentId])
}

// ---------------------------------------------------------------
// RAG materializado por Conversation (Fase 13 STEP 17)
// ---------------------------------------------------------------

/// Estado de uma definição de frame de pesquisa de uma Conversation.
enum ConversationRagFrameStatus {
  READY
  FAILED
}

/// Estado de uma materialização de um frame.
enum ConversationRagSnapshotStatus {
  NEW
  MATERIALIZING
  READY
  STALE
  FAILED
}

/// Definição do que uma Conversation pesquisa em um determinado frame/tópico.
/// O vínculo semântico entre Conversation e uma consulta de retrieval:
///   Conversation → ConversationRagFrame (1:N).
/// O `frameKey` é a identidade determinística do frame (hash de query +
/// scope + config); `scopeSourceIds` usa `Json?` (lista de IDs de
/// ExternalSource), seguindo a convenção de JSON do projeto. Ownership é
/// herdado da Conversation — NÃO há ownerId redundante.
model ConversationRagFrame {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  queryText String
  queryHash String

  // Lista opcional de source IDs que restringem a retrieval (JSON array de
  // UUIDs, canonicalizado+ordenado na escrita). Json não pode entrar em
  // @@unique, então a identidade determinística vive em `frameKey`.
  scopeSourceIds Json?

  topK        Int
  threshold   Float
  provider    String
  model       String
  version     String
  dimensions  Int
  ruleApplied String

  // Identidade determinística do frame (queryHash + scopeSourceIds + config).
  frameKey String

  status    ConversationRagFrameStatus @default(READY)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  snapshots ConversationRagSnapshot[]

  @@unique([conversationId, frameKey])
  @@index([conversationId, createdAt])
}

/// Uma materialização de um frame num determinado estado/freshness.
/// "Qual materialização foi produzida" para o frame. `snapshotKey` é a
/// identidade determinística da materialização (frameKey + freshnessAnchor).
model ConversationRagSnapshot {
  id      String               @id @default(uuid()) @db.Uuid
  frameId String               @db.Uuid
  frame   ConversationRagFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  snapshotKey String

  status          ConversationRagSnapshotStatus @default(NEW)
  retrievedAt     DateTime
  // Hash determinístico das dependências que invalidam o resultado (chunk
  // contentHash/embeddedContentHash + provider/model/version/dimensions/
  // scope/config). CURRENT = READY cujo freshnessAnchor coincide com o estado
  // de referência atual.
  freshnessAnchor String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ConversationRagSnapshotItem[]

  @@unique([frameId, snapshotKey])
  @@index([frameId, status])
  @@index([status, retrievedAt])
}

/// Linha por item de um snapshot: quais chunks foram recuperados e com qual
/// ranking. Apenas REFERÊNCIA a ExternalChunk (chunkId) + score/distance/
/// order/citation. NÃO duplica content/embedding/vector — ExternalChunk
/// continua dono do conteúdo e do vetor.
model ConversationRagSnapshotItem {
  id         String                  @id @default(uuid()) @db.Uuid
  snapshotId String                  @db.Uuid
  snapshot   ConversationRagSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  chunkId String        @db.Uuid
  chunk   ExternalChunk @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  score    Float
  distance Float
  order    Int
  citation String

  @@unique([snapshotId, chunkId])
  @@index([chunkId])
}

// ---------------------------------------------------------------
// Estado do mundo
// ---------------------------------------------------------------

/// Estado temporal atual do universo. Mantém apenas referências escalares
/// (sem @relation) para o Season/Race/Conversation ativos, evitando
/// circularidade. O mundo existe independentemente do chat.
enum TimelineEventKind {
  WORLD_ADVANCED
  RACE_RESULT_CORRECTED
  RACE_SESSION_RESULT_CORRECTED
  STANDING_CORRECTED
  NUMBER_CORRECTED
  RACE_SCHEDULED
  RACE_UPDATED
  ATTRIBUTE_EVOLVED
  SESSION_COMPLETED
  PERSONA_UPDATED
  HISTORICAL_CHAMPION_OVERRIDE_SET
  HISTORICAL_CHAMPION_OVERRIDE_CLEARED
}

/// Log append-only de mudanças temporais do Universe. Ordenação determinística
/// por (worldDate, sequence); correções retroativas entram com worldDate passado
/// e são aplicadas no ponto histórico correspondente durante o replay.
model TimelineEvent {
  id           String            @id @default(uuid()) @db.Uuid
  universeId   String            @db.Uuid
  universe     Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  sequence     Int
  worldDate    DateTime
  kind         TimelineEventKind
  payload      Json
  causedBy     String?
  supersedesId String?           @db.Uuid
  supersedes   TimelineEvent?    @relation("TimelineSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy TimelineEvent[]   @relation("TimelineSupersession")

  pilotExperiences PilotExperience[]
  memories         Memory[]

  createdAt DateTime @default(now())

  @@unique([universeId, sequence])
  @@index([universeId, worldDate, sequence])
}

/// Checkpoint materializado do estado do Universe em uma sequence da timeline.
model WorldSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  sequence   Int
  worldDate  DateTime
  state      Json
  createdAt  DateTime @default(now())

  @@unique([universeId, sequence])
  @@index([universeId, sequence])
}

/// Estado atual do mundo do universo (temporada/corrida/sessão correntes).
model WorldState {
  id  String @id @default(uuid()) @db.Uuid
  key String @default("default")

  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  currentDate     DateTime     @default(now())
  currentSeasonId String?      @db.Uuid // referência escalar a Season (sem @relation)
  currentRaceId   String?      @db.Uuid // referência escalar a Race (sem @relation)
  currentSession  RaceSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, key])
}

// ---------------------------------------------------------------
// Comportamento e disponibilidade
// ---------------------------------------------------------------

/// Estado atual de disponibilidade de um Character.
model CharacterAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  status AvailabilityStatus @default(AVAILABLE)
  reason String?
  since  DateTime           @default(now())
  until  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId])
  @@index([status])
}

/// Rotina/agenda de um Character (eventos futuros programados).
model CharacterSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  activity String
  startsAt DateTime
  endsAt   DateTime?

  createdAt DateTime @default(now())

  @@index([characterId, startsAt])
}

enum AiDecisionStatus {
  NO_ACTION
  DECIDED
  EXECUTING
  EXECUTED
  REJECTED
  FAILED
}

enum AiActionType {
  NO_ACTION
  RESPOND
  SEND_MESSAGE
  CREATE_EVENT
  CREATE_MEMORY
  UPDATE_RELATIONSHIP
}

/// Auditoria de decisão comportamental de um Character AI (Universe-scoped).
/// Sem prompts/contexto completo: apenas referência mínima e resultado.
model AiDecision {
  id          String    @id @default(uuid()) @db.Uuid
  universeId  String    @db.Uuid
  universe    Universe  @relation(fields: [universeId], references: [id], onDelete: Cascade)
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  status      AiDecisionStatus
  actionType  AiActionType     @default(NO_ACTION)
  conversationId     String?   @db.Uuid
  reason             String?
  contextVersion     String
  policyCode         String?
  executedMessageId  String?   @db.Uuid
  executedEventId    String?   @db.Uuid
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universeId, characterId, createdAt])
  @@index([characterId, status, actionType, createdAt])
}

/// Preferências de domínio do usuário que não pertencem ao Better Auth
/// (nome/imagem continuam em User, fonte única do modelo de autenticação).
model UserProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favoriteTeamId String?        @db.Uuid
  favoriteTeam   Team?          @relation("UserProfileFavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)
  favoriteDriverId String?      @db.Uuid
  favoriteDriver   DriverProfile? @relation("UserProfileFavoriteDriver", fields: [favoriteDriverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([favoriteTeamId])
  @@index([favoriteDriverId])
}

/// Tipo de mídia armazenada por um StorageProvider.
enum MediaKind {
  USER_AVATAR
}

/// Recurso de mídia armazenado (storageKey pertence ao provider; nunca
/// exposto ao cliente). O domínio guarda apenas a referência.
model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @db.Uuid
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind        MediaKind @default(USER_AVATAR)

  provider         String
  storageKey       String  @unique
  originalFilename String?
  mimeType         String
  byteSize         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

enum PersonaOrigin {
  ORIGINAL
  REAL_DRIVER
  AI_CHARACTER
}

enum PersonaTraitSource {
  MANUAL
  EVIDENCE
}

enum PersonaEvidenceType {
  OFFICIAL_PROFILE
  INTERVIEW
  BIOGRAPHY
  PUBLIC_STATEMENT
  OTHER_APPROVED
}

enum PersonaEvidenceStatus {
  PROPOSED
  APPROVED
  REJECTED
}

model CharacterPersona {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @unique @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  origin        PersonaOrigin
  summary       String?
  schemaVersion String        @default("persona.v1")

  evolutionRevision  Int       @default(0)
  evolutionAppliedAt DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("PersonaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  traits          PersonaTrait[]
  evidences       PersonaEvidence[]
  traitEvolutions PersonaTraitEvolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BiographyGenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  SUCCEEDED_FALLBACK
  FAILED
  CANCELLED
}

enum BiographyGenerationMode {
  LLM
  RICH_DETERMINISTIC
  COMPACT_FALLBACK
}

/// Auditoria de geração de biografia: prompt final, versões, tempos e status.
/// A biografia legível continua sendo BIOGRAPHY_PAGE (ExternalKnowledgeSource).
model BiographyGenerationRun {
  id               String    @id @default(uuid()) @db.Uuid
  characterId      String    @db.Uuid
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  externalDriverId String?   @db.Uuid

  status           BiographyGenerationStatus @default(PENDING)
  mode             BiographyGenerationMode?
  provider         String?
  model            String?
  prompt           Json?
  promptVersion    String
  promptHash       String
  evidenceVersion  String?
  generatorVersion String
  fingerprint      String?
  fallbackReason   String?
  failureReason    String?
  outputSourceId   String?                   @db.Uuid
  timings          Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
  @@index([status, startedAt])
}

model PersonaTrait {
  id        String           @id @default(uuid()) @db.Uuid
  personaId String           @db.Uuid
  persona   CharacterPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  key        String
  value      String
  confidence Float
  sourceKind PersonaTraitSource
  context    PersonaTraitContext @default(ON_TRACK)

  evidenceId String?          @db.Uuid
  evidence   PersonaEvidence? @relation("TraitAuthoritativeEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, key, context])
  @@index([personaId])
  @@index([evidenceId])
}

enum PersonaTraitContext {
  ON_TRACK
  OFF_TRACK
}

model PersonaEvidence {
  id        String           @id @default(uuid()) @db.Uuid
  personaId String           @db.Uuid
  persona   CharacterPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  traitKey      String
  proposedValue String

  sourceType  PersonaEvidenceType
  title       String
  url         String?
  publishedAt DateTime?
  excerpt     String
  confidence  Float
  status      PersonaEvidenceStatus @default(PROPOSED)

  createdById  String?   @db.Uuid
  createdBy    User?     @relation("PersonaEvidenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("PersonaEvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  authoritativeTraits PersonaTrait[] @relation("TraitAuthoritativeEvidence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId, status])
  @@index([personaId, traitKey])
}

// ---------------------------------------------------------------------------
// V3.17 — Pilot Knowledge (External Driver Knowledge + Universe overrides)
// External Knowledge != Universe Truth: nada aqui escreve o Universe.
// ---------------------------------------------------------------------------

enum ExternalKnowledgeProvider {
