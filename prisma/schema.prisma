  SIGNIFICANT_RACE
  CAREER_ENTRY
}

enum ExternalEventDerivation {
  DERIVED_RESULTS
  DERIVED_STANDINGS
  CURATED_SOURCE
}

/// Ledger de proveniência/licença do conhecimento externo de piloto.
/// Nunca armazena páginas/artigos/transcrições — apenas metadados + claims.
model ExternalKnowledgeSource {
  id       String                      @id @default(uuid()) @db.Uuid
  provider ExternalKnowledgeProvider
  sourceKind ExternalKnowledgeSourceKind
  url      String?
  title    String?

  license                 ExternalKnowledgeLicense @default(UNKNOWN)
  attributionRequirement  String?
  attributionText         String?
  publishedAt             DateTime?
  retrievedAt             DateTime                @default(now())
  sourceVersion           String?
  metadata                Json?

  driverProfiles       ExternalDriverProfile[]    @relation("ExternalDriverProfilePrimarySource")
  biographyProfiles    ExternalDriverProfile[]    @relation("ExternalDriverProfileBiographySource")
  personaEvidences     ExternalPersonaEvidence[]
  driverRelationships  ExternalDriverRelationship[]
  driverEvents         ExternalDriverEvent[]

  createdAt DateTime @default(now())

  @@unique([provider, url])
  @@index([provider, retrievedAt])
}

/// Identidade/biografia estruturada de um piloto externo (1:1 ExternalDriver).
model ExternalDriverProfile {
  id               String         @id @default(uuid()) @db.Uuid
  externalDriverId String         @unique @db.Uuid
  externalDriver   ExternalDriver @relation(fields: [externalDriverId], references: [id], onDelete: Cascade)

  fullName           String?
  publicName         String?
  dateOfBirth        DateTime?
  placeOfBirth       String?
  nationality        String?
  representedCountry String?
  driverNumber       Int?
  driverCode         String?
  currentTeamName    String?
  officialLinks      Json?

  biographyDisplay  String?
  biographyContext  String?
  biographySourceId String?                 @db.Uuid
  biographySource   ExternalKnowledgeSource? @relation("ExternalDriverProfileBiographySource", fields: [biographySourceId], references: [id], onDelete: SetNull)

  wikidataQid  String? @unique
  f1dbDriverId String? @unique

  refreshStatus  ExternalRefreshStatus @default(UNKNOWN)
  lastVerifiedAt DateTime?

  sourceId String?                 @db.Uuid
  source   ExternalKnowledgeSource? @relation("ExternalDriverProfilePrimarySource", fields: [sourceId], references: [id], onDelete: SetNull)

  persona ExternalDriverPersona?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([refreshStatus, lastVerifiedAt])
}

/// Perfil público observável do piloto (baseline externa; não é a persona do Universe).
model ExternalDriverPersona {
  id        String               @id @default(uuid()) @db.Uuid
  profileId String               @unique @db.Uuid
  profile   ExternalDriverProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  schemaVersion  String              @default("external-persona.v1")
  summary        String?
  status         ExternalClaimStatus @default(UNKNOWN)
  lastVerifiedAt DateTime?

  traits    ExternalPersonaTrait[]
  evidences ExternalPersonaEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalPersonaTrait {
  id        String                @id @default(uuid()) @db.Uuid
  personaId String                @db.Uuid
  persona   ExternalDriverPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  traitKey   String
  value      String
  sourceKind ExternalPublicTraitSource
  status     ExternalClaimStatus       @default(SUPPORTED)
  confidence Float?

  evidenceId String?                 @db.Uuid
  evidence   ExternalPersonaEvidence? @relation("ExternalTraitAuthoritativeEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, traitKey])
  @@index([personaId])
  @@index([evidenceId])
}

model ExternalPersonaEvidence {
  id        String                @id @default(uuid()) @db.Uuid
  personaId String                @db.Uuid
  persona   ExternalDriverPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  traitKey      String
  proposedValue String
  evidenceType  ExternalPublicEvidenceType
  sourceKind    ExternalPublicTraitSource    @default(OBSERVED_PUBLIC_BEHAVIOR)

  sourceId String?                 @db.Uuid
  source   ExternalKnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  summary      String
  confidence   Float?
  status       ExternalClaimStatus @default(SUPPORTED)
  retrievedAt  DateTime            @default(now())

  authoritativeTraits ExternalPersonaTrait[] @relation("ExternalTraitAuthoritativeEvidence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId, traitKey])
  @@index([personaId, status])
}

model ExternalDriverRelationship {
  id               String         @id @default(uuid()) @db.Uuid
  externalDriverId String         @db.Uuid
  externalDriver   ExternalDriver @relation("ExternalDriverRelationshipSubject", fields: [externalDriverId], references: [id], onDelete: Cascade)

  kind       DriverRelationshipKind
  targetType DriverRelationshipTarget

  targetExternalDriverId String?         @db.Uuid
  targetExternalDriver   ExternalDriver? @relation("ExternalDriverRelationshipTarget", fields: [targetExternalDriverId], references: [id], onDelete: SetNull)
  targetWikidataQid      String?

  displayName String
  state       DriverRelationshipState @default(UNKNOWN)
  validFrom   DateTime?
  validTo     DateTime?

  sourceId       String?                 @db.Uuid
  source         ExternalKnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  confidence     Float?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalDriverId, kind])
  @@index([targetExternalDriverId])
}

/// Marco histórico resumido (não duplica RaceResult).
model ExternalDriverEvent {
  id               String         @id @default(uuid()) @db.Uuid
  externalDriverId String         @db.Uuid
  externalDriver   ExternalDriver @relation(fields: [externalDriverId], references: [id], onDelete: Cascade)

  category ExternalDriverEventCategory
  title    String

  eventDate     DateTime?
  seasonYear    Int?
  externalRaceId String?        @db.Uuid
  externalRace   ExternalRace?  @relation(fields: [externalRaceId], references: [id], onDelete: SetNull)

  summary    String?
  importance Int                @default(3)
  derivation ExternalEventDerivation

  sourceId String?                 @db.Uuid
  source   ExternalKnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalDriverId, dedupeKey])
  @@index([externalDriverId, eventDate])
}

/// Override Universe-scoped de relacionamento público de um piloto (nunca toca o externo).
model UniverseDriverRelationship {
  id         String   @id @default(uuid()) @db.Uuid
  universeId String   @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  characterId String    @db.Uuid
  character   Character @relation("UniverseRelationshipSubject", fields: [characterId], references: [id], onDelete: Cascade)

  kind       DriverRelationshipKind
  targetType DriverRelationshipTarget

  targetCharacterId String?    @db.Uuid
  targetCharacter   Character? @relation("UniverseRelationshipTarget", fields: [targetCharacterId], references: [id], onDelete: SetNull)
  targetWikidataQid String?

  displayName String
  state       DriverRelationshipState @default(UNKNOWN)
  validFrom   DateTime?
  validTo     DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("UniverseDriverRelationshipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universeId, characterId, kind])
  @@index([targetCharacterId])
}

// ---------------------------------------------------------------------------
// V3.18 — Pilot Experience, Memory & Evolution
// Experience é projeção determinística de fatos do Universe; Memory é a
// representação durável; evolução de persona é baseline + efeitos append-only.
// ---------------------------------------------------------------------------

enum PilotExperienceType {
  CAREER_MILESTONE
  SPORTING_VICTORY
  SPORTING_DEFEAT
  CHAMPIONSHIP
  TEAM_CHANGE
  RELATIONSHIP_EVENT
  CONFLICT
  PERSONAL_MILESTONE
  NARRATIVE_EVENT
  SIGNIFICANT_RACE
  OTHER_RELEVANT_EXPERIENCE
}

enum PilotExperienceSource {
  RACE_RESULT
  STANDING
  TIMELINE_CORRECTION
  UNIVERSE_EVENT
  RELATIONSHIP
  CURATED
}

enum PilotExperienceStatus {
  ACTIVE
  INVALIDATED
  SUPERSEDED
}

enum PilotMemoryDerivation {
  MANUAL
  DERIVED
  RULE_DERIVED
}

enum PilotMemoryStatus {
  ACTIVE
  ARCHIVED
  SUPERSEDED
  INVALIDATED
}

enum PilotEvolutionStatus {
  ACTIVE
  SUPERSEDED
}

/// Acontecimento vivenciado pelo piloto, derivado deterministicamente de fatos
/// do Universe. Nunca substitui RaceResult/Event/TimelineEvent; é resumo/marco.
model PilotExperience {
  id               String         @id @default(uuid()) @db.Uuid
  universeId       String         @db.Uuid
  universe         Universe       @relation(fields: [universeId], references: [id], onDelete: Cascade)
  characterId      String         @db.Uuid
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  experienceType PilotExperienceType
  source         PilotExperienceSource
  sourceKey      String

  seasonYear Int?
  seasonId   String?  @db.Uuid
  season     Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  raceId     String?  @db.Uuid
  race       Race?    @relation(fields: [raceId], references: [id], onDelete: SetNull)
  eventId    String?  @db.Uuid
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  timelineEventId String?        @db.Uuid
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id], onDelete: SetNull)

  occurredAt DateTime?
  salience   MemoryImportance @default(MEDIUM)
  title      String
  summary    String?

  status             PilotExperienceStatus @default(ACTIVE)
  invalidationReason String?
  revision           Int                   @default(1)

  memories        Memory[]
  traitEvolutions PersonaTraitEvolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universeId, characterId, source, sourceKey])
  @@index([universeId, characterId, status])
  @@index([universeId, seasonId])
  @@index([universeId, raceId])
}

/// Efeito de evolução de persona (append-only). O valor efetivo é sempre
/// baseline + soma dos efeitos ativos; nunca mutação cumulativa no trait.
model PersonaTraitEvolution {
  id        String           @id @default(uuid()) @db.Uuid
  personaId String           @db.Uuid
  persona   CharacterPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  traitKey  String
  ruleCode  String
  rulePriority Int
  value     String?
  confidenceDelta Float
  reason    String

  sourceExperienceId String?          @db.Uuid
  sourceExperience   PilotExperience? @relation(fields: [sourceExperienceId], references: [id], onDelete: SetNull)

  fingerprint String @unique
  appliedAt   DateTime @default(now())
  status      PilotEvolutionStatus @default(ACTIVE)

  @@index([personaId, traitKey])
  @@index([personaId, status])
  @@index([sourceExperienceId])
}

enum CharacterGoalKind {
  WIN_RACE
  WIN_CHAMPIONSHIP
  OUTPERFORM_TEAMMATE
  RECOVER_AFTER_SETBACK
  PROTECT_RELATIONSHIP
  CONFRONT_RIVAL
