}

enum ExternalPublicEvidenceType {
  SELF_DESCRIPTION
  OFFICIAL_INTERVIEW
  FIA_TRANSCRIPT
  TEAM_PROFILE
  F1_PROFILE
  DRIVER_OFFICIAL
  REPUTABLE_NEWS
  STRUCTURED_DATA
}

enum DriverRelationshipKind {
  ROMANTIC_PARTNER
  SPOUSE
  PARENT
  CHILD
  SIBLING
  TEAMMATE
  TEAM_RELATION
  MENTOR
  OTHER_PUBLIC_RELATION
}

