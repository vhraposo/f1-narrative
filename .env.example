# ------------------------------------------------------------------
# F1 Narrative Universe — variáveis de ambiente (exemplo)
# Copie para .env e ajuste conforme necessário.
# ------------------------------------------------------------------

# --- Banco de dados -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/f1_narrative?schema=public"

# --- API (apps/api) -------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0

# URL pública a partir da qual a API é acessada pelo frontend/navegador.
# Necessária para a autenticação (Better-Auth).
BETTER_AUTH_URL=http://localhost:3001

# Segredo usado para assinar tokens de sessão da autenticação.
# Gere um valor forte em desenvolvimento: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# --- Web (apps/web) -------------------------------------------------
# URL pública da API vista pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origem do frontend (usada para CORS na API).
CLIENT_ORIGIN=http://localhost:3000

# --- Geração real via Ollama (opcional) ------------------------------
# Sem OLLAMA_MODEL a API roda em assembly-only (NullProvider).
# Com OLLAMA_MODEL, o runtime usa OllamaProvider; config inválida falha o
# startup; Ollama indisponível nas chamadas retorna 500 PROVIDER_ERROR.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=30000

# --- OpenF1 (enriquecimento visual de pilotos) ---------------------------
OPENF1_BASE_URL=https://api.openf1.org/v1/
OPENF1_TIMEOUT_MS=30000
OPENF1_MAX_RETRIES=1

# --- Storage de mídia (avatares) --------------------------------------
# Provider: "local" (dev/testes) ou "s3" (S3-compatible).
STORAGE_PROVIDER=local
# Diretório raiz do provider local (não versionado).
STORAGE_LOCAL_ROOT=./.storage
# Tamanho máximo de upload em bytes (padrão 5 MB).
STORAGE_MAX_UPLOAD_BYTES=5242880
# S3-compatible (preencher apenas com STORAGE_PROVIDER=s3).
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=f1nw-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
